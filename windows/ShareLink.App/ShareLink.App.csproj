<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShareLink</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ShareLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ShareLink.ReleaseChannel" Value="Public" />
    <ProjectReference Include="../ShareLink.BrowserSharing/ShareLink.BrowserSharing.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Resource Include="ShareLinkLogo.png" />
    <None Update="transport-modules.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\target\release\sharelink_core.dll')">
    <None Include="..\..\target\release\sharelink_core.dll" Link="sharelink_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

